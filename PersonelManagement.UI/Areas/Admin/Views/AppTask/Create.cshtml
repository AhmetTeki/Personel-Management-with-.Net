@model PersonelManagement.Application.Requests.AppTaskCreateRequest
@{
    Layout = "_Layout";
}

<div class="container">
    <form asp-action="Create" asp-controller="AppTask" asp-area="Admin" method="post">
        <div class="row">
            <div class="col-12 text-center">
                <h3>Yeni İş Emri Ekle</h3>
            </div>
            <div class="col-4">
                <label class="form-label">İş Emri</label>
                <input type="text" asp-for="Title" class="form-control" placeholder="Aciliyet Tanımı" required>
            </div>
            <div class="col-4">
                <label class="form-label">İş Emri</label>
                <input type="text" asp-for="Description" class="form-control" placeholder="Aciliyet Tanımı" required>
            </div>
            <div class="col-12 mt-3">
                <select asp-for="PriorityId" asp-items="ViewBag.Priorities">
                    
                </select>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-primary">Kaydet</button>
        </div>
        <div asp-validation-summary="All" class="text-danger lead"></div>
    </form>
</div>